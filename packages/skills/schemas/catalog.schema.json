{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.example/schemas/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "presets": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
          },
          "optional": {
            "const": true
          },
          "skill_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "uniqueItems": true
          },
          "optional_skill_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "uniqueItems": true
          },
          "path": {
            "type": "string",
            "pattern": "^presets/[a-z0-9-]+/SKILL\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "version",
          "optional",
          "skill_ids",
          "optional_skill_ids",
          "path",
          "sha256",
          "estimated_tokens"
        ]
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
          },
          "kind": {
            "enum": [
              "adapted",
              "original"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^bundles/[a-z0-9-]+/SKILL\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "enum": [
              "MIT",
              "Apache-2.0"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "uniqueItems": true
          },
          "permission_hints": {
            "type": "array",
            "items": {
              "enum": [
                "file_read",
                "file_write",
                "code_execute",
                "network_read",
                "external_send",
                "deploy",
                "delegate",
                "financial_action"
              ]
            },
            "uniqueItems": true
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "version",
          "kind",
          "path",
          "sha256",
          "license",
          "source_ids",
          "permission_hints",
          "estimated_tokens"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "presets",
    "skills"
  ]
}
