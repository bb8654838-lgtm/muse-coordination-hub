{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.example/schemas/configuration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "role": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "preset"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
            }
          },
          "required": [
            "kind",
            "id",
            "version"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "custom"
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "id",
            "version"
          ]
        }
      ]
    },
    "skills": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "const": "bundled"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 120
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "id",
              "version",
              "enabled"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "const": "custom"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "id",
              "version",
              "enabled"
            ]
          }
        ]
      },
      "uniqueItems": true
    },
    "instructions": {
      "type": "string",
      "maxLength": 20000
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_read": {
          "type": "boolean"
        },
        "file_write": {
          "type": "boolean"
        },
        "code_execute": {
          "type": "boolean"
        },
        "network_read": {
          "type": "boolean"
        },
        "external_send": {
          "type": "boolean"
        },
        "deploy": {
          "type": "boolean"
        },
        "delegate": {
          "type": "boolean"
        },
        "financial_action": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "workspace_id",
    "base_revision",
    "role",
    "skills",
    "instructions",
    "permissions"
  ]
}
