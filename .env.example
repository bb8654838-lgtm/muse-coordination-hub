# Vercel web application (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC peppers (required; generate independent random values)
MUSE_AGENT_KEY_PEPPER=
MUSE_INVITE_PEPPER=

# Bridge runtime (required wherever a bridge runs)
MUSE_HUB_URL=
MUSE_AGENT_KEY=

# Supabase CLI deployment (local/CI only; never expose to the browser)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
