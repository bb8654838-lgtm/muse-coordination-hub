# Copy this file to .env.local for local development, or add the same
# values in the Vercel project settings. Never commit populated secrets.

# Supabase web runtime (required)
# Example URL: https://your-project-ref.supabase.co
# Find these under Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server runtime (required, server-only; never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-side HMAC peppers (required; generate two independent values)
# Example generator: openssl rand -hex 32
MUSE_AGENT_KEY_PEPPER=
MUSE_INVITE_PEPPER=

# Owner authentication
# Muse uses a Supabase Auth email/password user that also owns a row in
# public.workspaces. Create that user in Supabase > Authentication > Users.
# These optional reference fields are not read by the application; leave them
# blank in deployed environments rather than storing owner credentials here.
OWNER_DEMO_EMAIL=
OWNER_DEMO_PASSWORD=

# Bridge runtime (required on each connected agent, not in the browser)
# Local example: http://localhost:3000
MUSE_HUB_URL=http://localhost:3000
# One-time agent key returned by POST /api/agents/register
MUSE_AGENT_KEY=

# Optional Supabase CLI/CI deployment values
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Optional Vercel CLI deployment value
VERCEL_TOKEN=

# Optional pack commerce bridge (server-only public API origin; no trailing path)
# Example: https://your-commerce-service.example.com
MUSE_COMMERCE_API_URL=
